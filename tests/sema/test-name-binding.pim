# forward reference
# perform:
#   - name binding
#   - function overloading
#   - type inference

# CHECK: var a :Int = foo()
# CHECK: var b :Float = foo(1)
var a = foo()
var b = foo(1)
let a-int = 1
let a-float = 1.0

# CHECK: var c :Float = foo(a-int, a-float)
var c = foo(a-int, a-float)


fun foo() -> Int:
    return 1

fun foo(a: Int) -> Float:
    return 1.0

fun foo(a: Int, b :Float) -> Float:
    return a-float

class Pet:
    var name: Str
    var age: Int

    fun __init__(self, name: Str, age: Int):
        self.name = name
        self.age = age

    fun hello(self):
        # CHECK: %(message "%s" self.name)
        %message("%s", self.name)

    fun get-age(self) -> Int:
        return self.age

# CHECK: var a-pet :Pet = Pet("hello", 1)
var a-pet = Pet("hello", 1)
# CHECK-NEXT: var age-1 :Int = a-pet.age
var age-1 = a-pet.age
# CHECK-NEXT: var age-2 :Int = a-pet.get-age()
var age-2 = a-pet.get-age()

# CHECK-NEXT: a-pet.hello()
a-pet.hello()

fun foo-2[T0, T1](a:T0, b:T1) -> T0:
    return a + b + 1

# CHECK: var call-foo-2 :Int = foo-2(1, 2)
var call-foo-2 = foo-2(1, 2)

fun min[T](a: T, b: T) -> T:
    return a if a < b else b

var ab = min(1, 2)
